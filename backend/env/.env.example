APP_ENV=development
APP_PORT=8200

DB_HOST=YOUR_DB_HOST
DB_PORT=YOUR_DB_PORT
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=YOUR_DB_NAME
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
# Connection lifetime in minutes.
DB_CONN_MAX_LIFETIME=30

REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=YOUR_REDIS_PORT
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

RABBITMQ_DEFAULT_USER=YOUR_RABBITMQ_DEFAULT_USER
RABBITMQ_DEFAULT_PASS=YOUR_RABBITMQ_DEFAULT_PASS
RABBITMQ_DEFAULT_VHOST=YOUR_RABBITMQ_DEFAULT_VHOST
RABBITMQ_HOST=YOUR_RABBITMQ_HOST
RABBITMQ_PORT=YOUR_RABBITMQ_PORT

OBJECT_STORAGE_ENDPOINT=YOUR_OBJECT_STORAGE_ENDPOINT
OBJECT_STORAGE_BUCKET_NAME=YOUR_OBJECT_STORAGE_BUCKET_NAME
OBJECT_STORAGE_REGION=YOUR_OBJECT_STORAGE_REGION
OBJECT_STORAGE_ACCESS_KEY=YOUR_OBJECT_STORAGE_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=YOUR_OBJECT_STORAGE_SECRET_KEY
OBJECT_STORAGE_FORCE_PATH_STYLE=1

AUTH_INTERNAL_JWT_ISSUER=YOUR_AUTH_INTERNAL_JWT_ISSUE
AUTH_INTERNAL_JWT_AUDIENCE=YOUR_AUTH_INTERNAL_JWT_AUDIENCE
AUTH_INTERNAL_JWT_PUBLIC_KEY_PEM_PATH=YOUR_AUTH_INTERNAL_JWT_PUBLIC_KEY_PEM_PATH

LOG_DIR=../logs